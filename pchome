ID_RE = re.compile(r"([A-Z0-9]{6}-[A-Z0-9]{9})(?:-(\d{3}))?", re.I)


def prod_id(ref):
    """URL / DYAJ8C-A900GXXXX / DYAJ8C-A900GXXXX-000 -> (group id, spec suffix or None)."""
    m = ID_RE.search(ref.strip())
    if not m:
        raise Usage(f"not a PChome product id or URL: {ref!r} (looks like DAAG8M-A900H3TL3)")
    return m.group(1).upper(), m.group(2)


