    h = Http(None, args.debug)
    try:
        d = parse_json(SEARCH, *h.request(SEARCH + "?" + urllib.parse.urlencode({"q": "衛生紙", "page": 1})))
        checks.append(["search", "ok", f"ecshweb search over HTTP ({d.get('TotalRows')} hits for 衛生紙)"])
    except (Net, ApiError) as e:
        checks.append(["search", "FAIL", str(e)])
    try:
        d = parse_json(PROD, *h.request(f"{PROD}/prod/DAAG8M-A900H3TL3&fields=Id,Name&_callback=cb"))
        if not d:
            raise ApiError("prodapi returned an empty reply")
        checks.append(["product", "ok", "ecapi-cdn prodapi over HTTP"])
    except (Net, ApiError) as e:
        checks.append(["product", "FAIL", str(e)])
    try:
        ver = _cdp_json("/json/version")
        checks.append(["cdp", "ok", f"{CDP} {ver.get('Browser')} (fallback + login --from-browser)"])
    except Net:
        checks.append(["cdp", "-", f"no browser on {CDP} (only for fallback / login --from-browser)"])
    if st.get("cookie"):
        try:
            u = member_info(st["cookie"], args.debug)
            checks.append(["login", "ok", f"{u['email']} via {st.get('source')} (verified over HTTP)"])
            cart = read_cart(Client(args, need_login=True))
            checks.append(["cart", "ok", f"{cart['count']} line(s), {nt(cart['total'])}"])
        except (Auth, ApiError, Net) as e:
            checks.append(["login", "FAIL", f"saved session rejected: {e}"])
    else:
        checks.append(["login", "-", "not signed in (search/product/price work; cart needs `pchome login`)"])
    bad = any(c[1] == "FAIL" for c in checks)
    payload = err("doctor found problems", EX_NET, checks=checks) if bad else ok({"checks": checks})
    if bad and not args.json:
        print(table(checks, ["check", "state", "detail"]))
    return emit(payload, args.json, lambda: table(checks, ["check", "state", "detail"]))


# ------------------------------------------------------------------ parser
class Parser(argparse.ArgumentParser):
    def error(self, message):
        as_json = "--json" in sys.argv
        emit(err(f"{self.prog}: {message}", EX_USAGE), as_json)
        if not as_json:
            self.print_usage(sys.stderr)
        sys.exit(EX_USAGE)


def build_parser():
    p = Parser(prog="pchome", description="PChome 24h購物 from the shell (no checkout).")
    p.add_argument("--version", action="version", version=VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="stable {ok, data|error} envelope")
    common.add_argument("--debug", action="store_true", help="dump HTTP calls to stderr")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="reads: direct HTTP, CDP background tab, or HTTP with browser fallback")
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=Parser)

    sub.add_parser("doctor", parents=[common], help="API reachability, browser, login + cart state"
                   ).set_defaults(fn=cmd_doctor)

    s = sub.add_parser("search", parents=[common], help="search products")
    s.add_argument("query")
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--sort", choices=list(SORTS), default="relevance")
    s.add_argument("--min", type=int, help="min price TWD")
    s.add_argument("--max", type=int, help="max price TWD")
    s.add_argument("--page", type=int, default=1)
    s.set_defaults(fn=cmd_search)

    pr = sub.add_parser("product", aliases=["item"], parents=[common],
                        help="one product: price, stock, shipping, specs")
    pr.add_argument("ref", help="product URL or id (DAAG8M-A900H3TL3)")
    pr.set_defaults(fn=cmd_product)

    pc = sub.add_parser("price", parents=[common], help="quick price/stock check for many ids")
    pc.add_argument("refs", nargs="+", help="product URLs or ids")
    pc.set_defaults(fn=cmd_price)

    r = sub.add_parser("raw", parents=[common], help="GET a read-only PChome JSON endpoint")
    r.add_argument("url", help="full URL, or a path under ecapi-cdn .../prodapi/v2/")
    r.set_defaults(fn=cmd_raw)

    lg = sub.add_parser("login", parents=[common], help="save a signed-in PChome session")
    g = lg.add_mutually_exclusive_group()
    g.add_argument("--from-browser", action="store_true",
                   help="(default) copy the session from the CDP browser; opens the login page "
                        "in a background tab and waits if it is not signed in")
    g.add_argument("--from-clipboard", action="store_true", help="Cookie header from the clipboard")
    g.add_argument("--cookie-stdin", action="store_true", help="paste/pipe a DevTools Cookie header")
    lg.add_argument("--cdp", help=f"CDP endpoint (default {CDP})")
    lg.add_argument("--wait", type=int, default=300, help="seconds to wait for you to sign in (default 300)")
    lg.add_argument("--keyring", action="store_true", help="store the cookie in the OS keyring")
    lg.set_defaults(fn=cmd_login)
    sub.add_parser("whoami", parents=[common], help="verify the saved session over HTTP"
                   ).set_defaults(fn=cmd_whoami)
    sub.add_parser("logout", parents=[common], help="forget the saved session"
                   ).set_defaults(fn=cmd_logout)

    ct = sub.add_parser("cart", parents=[common], help="購物車: list / add / rm / qty (no checkout)")
    ct.add_argument("action", choices=["list", "add", "rm", "qty"])
    ct.add_argument("ref", nargs="?", help="add: product id/URL; rm/qty: line # or product id")
    ct.add_argument("n", nargs="?", type=int, help="qty: new quantity")
    ct.add_argument("--qty", type=int, default=1, help="add: quantity (default 1)")
    ct.add_argument("--spec", "--opt", dest="spec", help="add: spec text (e.g. 38) or spec id (…-004)")
    ct.add_argument("--yes", action="store_true", help="really change the cart (else dry run)")
    ct.set_defaults(fn=cmd_cart)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except Usage as e:
        return emit(err(str(e), EX_USAGE, **(e.detail or {})), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, **(e.detail or {})), args.json)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
