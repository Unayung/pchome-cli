class Net(Exception):
    pass


class Blocked(Net):
    pass


class Auth(Exception):
    pass


class ApiError(Exception):
    def __init__(self, msg, detail=None):
        super().__init__(msg)
        self.detail = detail


class Usage(ApiError):
    pass


# ---------------------------------------------------------------- envelope
def ok(data):
    return {"ok": True, "data": data}


def err(msg, code=EX_ERR, **detail):
    return {"ok": False, "error": {"message": msg, "code": code, "detail": detail or None}}


def emit(payload, as_json, human=None):
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif payload.get("ok"):
        print(human() if callable(human) else
              (human if human is not None else
               json.dumps(payload["data"], ensure_ascii=False, indent=2)))
    else:
        print(payload["error"]["message"], file=sys.stderr)
    return EX_OK if payload.get("ok") else payload["error"]["code"]


def _w(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in str(text))


def table(rows, headers):
    if not rows:
        return "(no rows)"
    cols = list(zip(*([headers] + rows)))
    widths = [max(_w(c) for c in col) for col in cols]
    pad = lambda t, w: str(t) + " " * max(0, w - _w(t))  # noqa: E731
    out = ["  ".join(pad(h, w) for h, w in zip(headers, widths)).rstrip(),
           "  ".join("-" * w for w in widths)]
    for r in rows:
        out.append("  ".join(pad(c, w) for c, w in zip(r, widths)).rstrip())
    return "\n".join(out)


def clip(text, n):
    text = (text or "").replace("\n", " ").strip()
    if _w(text) <= n:
        return text
    out = ""
    for c in text:
        if _w(out + c) > n - 1:
            break
        out += c
    return out + "…"


def nt(v):
    return "" if v is None else f"${v:,}"


# -------------------------------------------------------- CDP (stdlib ws)
class WS:
    def __init__(self, url, timeout=60):
        if not url.startswith("ws://"):
            raise Net(f"unsupported websocket url {url}")
        hostport, path = url[5:].split("/", 1)
        host, port = hostport.rsplit(":", 1)
        try:
            self.s = socket.create_connection((host, int(port)), timeout=timeout)
        except OSError as e:
            raise Net(f"cannot reach browser at {hostport}: {e}")
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\n"
                        "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\n"
                        "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.s.recv(4096)
            if not chunk:
                raise Net("websocket handshake closed")
            buf += chunk
        if b" 101 " not in buf.split(b"\r\n")[0]:
            raise Net("websocket handshake refused (start Edge with --remote-allow-origins='*')")
        self.rest = buf.split(b"\r\n\r\n", 1)[1]
        self.n = 0

    def _recv(self, n):
        while len(self.rest) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise Net("browser closed the connection")
            self.rest += chunk
        out, self.rest = self.rest[:n], self.rest[n:]
        return out

    def _send(self, obj):
        data = json.dumps(obj).encode()
        hdr = bytearray([0x81])
        n = len(data)
        if n < 126:
            hdr.append(0x80 | n)
        elif n < 65536:
            hdr.append(0x80 | 126)
            hdr += struct.pack(">H", n)
        else:
            hdr.append(0x80 | 127)
            hdr += struct.pack(">Q", n)
        mask = os.urandom(4)
        hdr += mask
        self.s.sendall(bytes(hdr) + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def _recv_msg(self):
        msg = b""
        while True:
            b0, b1 = self._recv(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._recv(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._recv(8))[0]
            payload = self._recv(n)
            op = b0 & 0x0F
            if op == 8:
                raise Net("browser closed the websocket")
            if op in (9, 10):
                continue
            msg += payload
            if b0 & 0x80:
                return json.loads(msg)

    def call(self, method, **params):
        self.n += 1
        i = self.n
        self._send({"id": i, "method": method, "params": params})
        while True:
            m = self._recv_msg()
            if m.get("id") == i:
                if "error" in m:
                    raise Net(f"{method}: {m['error'].get('message')}")
                return m["result"]

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def _cdp_json(path):
    try:
        with urllib.request.urlopen(CDP + path, timeout=5) as r:
            return json.loads(r.read())
    except OSError as e:
        raise Net(f"no browser on {CDP} ({e}). start Edge with --remote-debugging-port=9222")


def browser_cookies():
    """All *.pchome.com.tw cookies of the CDP browser (no tab needed)."""
    b = WS(_cdp_json("/json/version")["webSocketDebuggerUrl"])
    try:
        cks = b.call("Storage.getCookies")["cookies"]
    finally:
        b.close()
    return [c for c in cks if c.get("domain", "").endswith("pchome.com.tw")]


def cookies_to_header(cks):
    """Prefer the .pchome.com.tw copy when a name exists on several hosts."""
    seen = {}
    for c in sorted(cks, key=lambda c: c["domain"] != ".pchome.com.tw"):
        seen.setdefault(c["name"], c["value"])
    return "; ".join(f"{k}={v}" for k, v in seen.items())


class Browser:
    """One background tab, closed on exit. Never focused; user tabs untouched."""

    def __init__(self, url=SITE + "/", debug=False):
        self.debug = debug
        self.b = WS(_cdp_json("/json/version")["webSocketDebuggerUrl"])
        self.tid = self.b.call("Target.createTarget", url=url, background=True)["targetId"]
        try:
            tgt = next(x for x in _cdp_json("/json/list") if x["id"] == self.tid)
            self.p = WS(tgt["webSocketDebuggerUrl"], timeout=90)
        except BaseException:
            self.close()
            raise

    def wait_ready(self, origin=SITE, limit=25):
        t0 = time.time()
        while time.time() - t0 < limit:
            try:
                r = self.eval("location.origin + '|' + document.readyState")
            except ApiError:
                r = None
            if r and r.startswith(origin) and r.endswith(("interactive", "complete")):
                return
            time.sleep(0.5)
        raise Net(f"{origin} did not load in the background tab")

    def eval(self, expr):
        r = self.p.call("Runtime.evaluate", expression=expr, awaitPromise=True, returnByValue=True)
        if r.get("exceptionDetails"):
            raise ApiError("page script failed: " + str(
                r["exceptionDetails"].get("exception", {}).get("description")
                or r["exceptionDetails"].get("text")))
        return r.get("result", {}).get("value")

    def get(self, url):
        """Top-level navigation of OUR tab to the URL (cross-origin fetch() is CORS-blocked:
        the web app itself uses JSONP), then read the body text."""
        self.p.call("Page.navigate", url=url)
        t0 = time.time()
        while time.time() - t0 < 25:
            time.sleep(0.4)
            try:
                r = self.eval("location.href + '\\n' + document.readyState + '\\n' + "
                              "document.contentType + '\\n' + (document.body ? "
                              "document.body.innerText : '')")
            except ApiError:
                continue
            href, state, ctype, body = (r.split("\n", 3) + ["", "", ""])[:4]
            if href.startswith(url[:40]) and state == "complete":
                return (200, body) if "html" not in ctype else (403, "<html>")
        raise Net(f"browser did not load {url[:80]}")

    def close(self):
        # Edge quits (clean exit) if the background tab we close is the
        # last "page" target left - guard: if ours is the only page, leave
        # it open (navigate to about:blank) instead of closing it.
        try:
            targets = self.b.call("Target.getTargets").get("targetInfos", [])
            pages = [t for t in targets if t.get("type") == "page"]
            only_page_left = len(pages) <= 1 and any(t.get("targetId") == self.tid for t in pages)
        except Exception:
            only_page_left = False
        try:
            if only_page_left:
                self.p.call("Page.navigate", url="about:blank")
            else:
                self.b.call("Target.closeTarget", targetId=self.tid)
        except Exception:
            pass
        for w in (getattr(self, "p", None), getattr(self, "b", None)):
            if w:
                w.close()

    def __enter__(self):
        return self

    def __exit__(self, *a):
        self.close()


# ------------------------------------------------------------------ state
def _keyring(op, secret=None):
    acct = "default"
    try:
        if sys.platform == "darwin":
            cmd = {"set": ["security", "add-generic-password", "-U", "-a", acct,
                           "-s", KEYRING_SERVICE, "-w", secret],
                   "get": ["security", "find-generic-password", "-a", acct, "-s", KEYRING_SERVICE, "-w"],
                   "del": ["security", "delete-generic-password", "-a", acct, "-s", KEYRING_SERVICE]}[op]
            r = subprocess.run(cmd, capture_output=True, text=True)
        else:
            base = ["service", KEYRING_SERVICE, "account", acct]
            cmd = {"set": ["secret-tool", "store", "--label=pchome-cli"] + base,
                   "get": ["secret-tool", "lookup"] + base,
                   "del": ["secret-tool", "clear"] + base}[op]
            r = subprocess.run(cmd, input=secret if op == "set" else None,
                               capture_output=True, text=True)
    except FileNotFoundError:
        raise Auth("no keyring tool (macOS `security` / Linux `secret-tool`)")
    if op == "get":
        return r.stdout.strip() if r.returncode == 0 else None
    if op == "set" and r.returncode != 0:
        raise Auth("keyring write failed: " + r.stderr.strip())
    return True


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    except (OSError, ValueError) as e:
        raise ApiError(f"state file unreadable: {e}")
    if os.environ.get("PCHOME_COOKIE"):
        st["cookie"], st["source"] = clean_cookie(os.environ["PCHOME_COOKIE"]), "env"
    elif st.get("cookie_in_keyring"):
        st["cookie"], st["source"] = _keyring("get"), "keyring"
    elif st.get("cookie"):
        st["source"] = "file"
    return st


def save_state(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    out = {k: v for k, v in st.items() if k != "source"}
    if out.get("cookie_in_keyring"):
        out.pop("cookie", None)
    tmp = STATE_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


COOKIE_PAIR = re.compile(r"^[!#$%&'*+.^_`|~0-9A-Za-z-]+=[\x21-\x7e]*$")


def clean_cookie(raw):
    """Keep only valid name=value pairs; refuse text that is not a PChome Cookie header."""
    raw = (raw or "").strip()
    if raw.lower().startswith("cookie:"):
        raw = raw.split(":", 1)[1].strip()
    pairs = [p.strip() for p in raw.replace("\n", ";").split(";")]
    good = [p for p in pairs if p and COOKIE_PAIR.match(p)]
    bad = [p for p in pairs if p and not COOKIE_PAIR.match(p)]
    if not any(p.startswith("ECWEBSESS=") for p in good):
        preview = raw[:40].encode("ascii", "replace").decode()
        raise Auth("that does not look like a PChome Cookie header (no ECWEBSESS; starts with "
                   f"{preview!r}). In DevTools > Network click a 24h.pchome.com.tw request > "
                   "Request Headers and copy the value of `Cookie`")
    if bad:
        print(f"note: dropped {len(bad)} malformed cookie part(s)", file=sys.stderr)
    return "; ".join(good)


# -------------------------------------------------------------- transport
def strip_jsonp(text):
    t = text.strip()
    m = re.match(r"^(?:try\{)?\s*[\w$.]+\((.*)\);?\s*(?:\}catch\(e\)\{.*\})?\s*$", t, re.S)
    return m.group(1) if m else t


class Http:
    """Direct HTTPS with a browser UA (+ the saved cookie when there is one)."""

    def __init__(self, cookie=None, debug=False):
        self.cookie, self.debug = cookie, debug

    def request(self, url, data=None, referer=SITE + "/", extra=None):
        h = {"User-Agent": UA, "Referer": referer, "Accept": "application/json, text/plain, */*",
             "Accept-Language": "zh-TW,zh;q=0.9"}
        if self.cookie:
            h["Cookie"] = self.cookie
        body = None
        if data is not None:
            h["Content-Type"] = "application/x-www-form-urlencoded; charset=UTF-8"
            h["Origin"] = ECSSL
            body = urllib.parse.urlencode(data).encode()
        h.update(extra or {})
        if self.debug:
            print(f"> {'POST' if body else 'GET'} {url}" + (f"  {data}" if data else ""), file=sys.stderr)
        req = urllib.request.Request(url, data=body, headers=h)
        try:
            with urllib.request.urlopen(req, timeout=25) as r:
                code, text = r.status, r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            code, text = e.code, e.read().decode("utf-8", "replace")
        except OSError as e:
            raise Net(f"{urllib.parse.urlparse(url).netloc}: {e}")
        if self.debug:
            print(f"< {code} {text[:300]}", file=sys.stderr)
        return code, text


def parse_json(url, code, text):
    host = urllib.parse.urlparse(url).netloc
    if code in (403, 429) or text.lstrip()[:1] == "<":
        raise Blocked(f"{host}: blocked or HTML reply (HTTP {code})")
    if code >= 400:
        raise ApiError(f"{host}: HTTP {code}", {"http": code, "url": url})
    try:
        return json.loads(strip_jsonp(text)) if text.strip() else None
    except ValueError:
        raise ApiError(f"{host}: non-JSON reply (HTTP {code})", {"head": text[:200]})


class Client:
    """HTTP first; on a bot wall retry that GET in a CDP background tab."""

    def __init__(self, args, need_login=False):
        self.args = args
        self.st = load_state()
        if need_login and not self.st.get("cookie"):
            raise Auth("not signed in - run `pchome login` (sign in to PChome in Edge yourself)")
        self.http = Http(self.st.get("cookie"), getattr(args, "debug", False))
        self.br = None

    def get(self, url, referer=SITE + "/"):
        if url.startswith(PROD) and "_callback=" not in url:
            # measured: prodapi path-style URLs (prod/<ID>&.., prod/spec&id=..) reply an
            # EMPTY 200 unless a JSONP _callback is given; prod?id= answers either way
            url += "&_callback=jsonp_cli"
        via = getattr(self.args, "via", "auto")
        if via != "browser":
            try:
                return parse_json(url, *self.http.request(url, referer=referer))
            except Blocked:
                if via == "http":
                    raise
                print(f"note: {urllib.parse.urlparse(url).netloc} blocked over HTTP, retrying via browser",
                      file=sys.stderr)
        if not self.br:
            self.br = Browser("about:blank", debug=self.args.debug)
        return parse_json(url, *self.br.get(url))

    def post(self, url, data, referer=CART_PAGE):
        # writes always go over HTTP with the SAVED session (never borrow the browser's)
        code, text = self.http.request(url, data=data, referer=referer)
        if code >= 400 or text.lstrip()[:1] == "<":
            raise ApiError(f"POST {urllib.parse.urlparse(url).path}: HTTP {code}", {"head": text[:200]})
        return text

    def __enter__(self):
        return self

    def __exit__(self, *a):
        if self.br:
            self.br.close()


