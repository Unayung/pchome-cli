def cmd_logout(args):
    st = load_state()
    if st.get("cookie_in_keyring"):
        _keyring("del")
    for k in ("cookie", "cookie_in_keyring", "user", "logged_in_at", "login_source", "source"):
        st.pop(k, None)
    save_state(st)
    msg = "local session removed (PChome itself is still signed in in your browser)"
    if os.environ.get("PCHOME_COOKIE"):
        msg += "; note PCHOME_COOKIE is still set in the environment"
    return emit(ok({"logged_out": True}), args.json, msg)


