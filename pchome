def read_cart(c):
    d = c.get(CARTAPI + "/ItemList?_=%d" % (time.time() * 1000), referer=CART_PAGE)
    if not isinstance(d, dict) or "itemlist" not in d:
        raise Auth("cart not readable with the saved session (signed out?) - run `pchome login`",)
    lines, n = [], 0
    for house, h in (d["itemlist"].get("houses") or {}).items():
        for pkg in h.get("packages") or []:
            for key, it in (pkg.get("items") or {}).items():
                n += 1
                lines.append({"line": n, "key": key, "id": it.get("IT_SNO"),
                              "prod": (it.get("IT_SNO") or "")[:16], "title": it.get("IT_NAME"),
                              "spec": it.get("SPEC") or "", "qty": it.get("QTY"),
                              "price": it.get("PRICE"), "subtotal": (it.get("PRICE") or 0) * (it.get("QTY") or 0),
                              "store": it.get("SR_NO"), "stock": it.get("StockQTY"),
                              "max_qty": it.get("UNIT"), "type": it.get("TYPE"),
                              "group": "PChome 快速到貨" if house == "24H" else "廠商出貨",
                              "error": it.get("Error")})
    total = sum(x["subtotal"] for x in lines)
    return {"lines": lines, "count": len(lines), "items_qty": sum(x["qty"] or 0 for x in lines),
            "total": total, "site_total": d.get("totalPrice")}


def cart_table(cart):
    rows = [[x["line"], x["id"], clip(x["title"], 38), clip(x["spec"], 10), x["qty"], nt(x["price"]),
             nt(x["subtotal"]), "快速到貨" if x["group"].startswith("PChome") else "廠商"] for x in cart["lines"]]
    return (table(rows, ["#", "id", "title", "spec", "qty", "price", "subtotal", "ship"]) +
            f"\n{cart['count']} line(s), {cart['items_qty']} item(s), total {nt(cart['total'])}")


def pick_spec(it, want):
    specs = it["specs"]
    if not specs:
        if want:
            raise Usage(f"{it['id']} has no specs; drop --spec")
        if not it["in_stock"]:
            raise ApiError(f"{it['title']} is sold out / not for sale ({it['button']})")
        return {"id": it["id"] + "-000", "spec": "", "price": it["price"], "qty": it["max_qty"]}
    if not want:
        raise Usage(f"{it['id']} needs --spec: " + " / ".join(
            f"{s['spec']} ({s['id']}{'' if s['buyable'] else ', sold out'})" for s in specs))
    w = want.strip().lower()
    hits = ([s for s in specs if s["id"].lower() == w or s["id"][-3:] == w] or
            [s for s in specs if (s["spec"] or "").lower() == w] or
            [s for s in specs if w in (s["spec"] or "").lower()])
    if len(hits) != 1:
        raise Usage(f"--spec {want!r} matches {len(hits)} specs: " +
                    " / ".join(f"{s['spec']} ({s['id']})" for s in (hits or specs)))
    if not hits[0]["buyable"]:
        raise ApiError(f"spec {hits[0]['spec']} ({hits[0]['id']}) is sold out")
    return hits[0]


def cart_tb(spec_id):
    # same rule the web app uses: 2nd id segment starting with D = SOFT (downloads), else 24H
    return "SOFT" if spec_id.split("-")[1][:1] == "D" else "24H"


def find_line(cart, ref):
    ref = ref.strip()
    if ref.isdigit() and len(ref) < 4:
        hits = [x for x in cart["lines"] if x["line"] == int(ref)]
    else:
        try:
            pid, suf = prod_id(ref)
            full = f"{pid}-{suf}" if suf else None
            hits = [x for x in cart["lines"] if x["id"] == full] if full else \
                [x for x in cart["lines"] if x["prod"] == pid]
        except Usage:
            hits = [x for x in cart["lines"] if x["key"] == ref]
    if len(hits) != 1:
        raise Usage(f"{len(hits)} cart lines match {ref!r} (use the line # from `pchome cart list`)",
                    {"lines": [f"{x['line']}: {x['id']} {x['title']}" for x in cart["lines"]]})
    return hits[0]


def cmd_cart(args):
    with Client(args, need_login=True) as c:
        if args.action == "list":
            cart = read_cart(c)
            return emit(ok(cart), args.json, lambda: cart_table(cart))

        if args.action == "add":
            if not args.ref:
                raise Usage("cart add needs a product id or URL")
            pid, suf = prod_id(args.ref)
            it = product_info(c, pid)
            sp = pick_spec(it, args.spec or (f"{pid}-{suf}" if suf and suf != "000" else None))
            if args.qty < 1 or (it["max_qty"] and args.qty > it["max_qty"]):
                raise Usage(f"--qty must be 1..{it['max_qty']}")
            plan = {"id": sp["id"], "title": it["title"], "spec": sp.get("spec") or "", "qty": args.qty,
                    "price": sp.get("price") or it["price"],
                    "total": (sp.get("price") or it["price"] or 0) * args.qty, "url": it["url"]}
            desc = (f"{args.qty}x {it['title']}" + (f" [{plan['spec']}]" if plan["spec"] else "") +
                    f"  {nt(plan['price'])} = {nt(plan['total'])}")
            if not args.yes:
                return emit(ok(dict(plan, dry_run=True)), args.json,
                            f"would add to cart: {desc}\nre-run with --yes")
            before = read_cart(c)
            had = next((x["qty"] for x in before["lines"] if x["id"] == sp["id"]), 0)
            mac = c.get(f"{CARTJS}/sys/cflow/ecapi/prod/cart/v1/prod/{pid}/snapup?_=%d" % time.time()) or {}
            if mac.get("Status") != "OK":
                raise ApiError("PChome refused the add-to-cart token (snapup)", {"reply": mac})
            data = {"G": [], "A": [], "B": [], "C": [], "TB": cart_tb(sp["id"]), "TP": 2, "T": "ADD",
                    "TI": sp["id"], "RS": it["store"], "YTQ": args.qty,
                    "CAX": mac.get("MAC"), "CAXE": mac.get("MACExpire")}
            r = c.get(f"{CARTJS}/cart/index.php/prod/modify?callback=jsonp_addcart&%d&data=%s"
                      % (time.time(), urllib.parse.quote(json.dumps(data, separators=(",", ":"), ensure_ascii=False))))
            if isinstance(r, dict) and r.get("OverQtyMsg"):
                raise ApiError(f"PChome: {r['OverQtyMsg']}", {"reply": r})
            time.sleep(0.5)
            after = read_cart(c)
            line = next((x for x in after["lines"] if x["id"] == sp["id"]), None)
            if not line or line["qty"] <= had:
                raise ApiError("PChome answered the add but the cart did not change",
                               {"reply": r, "qty_before": had})
            return emit(ok({"added": plan, "verified_line": line, "qty_before": had,
                            "cart_count": after["count"], "cart_total": after["total"]}), args.json,
                        f"added: {desc}\nverified in cart: line {line['line']} {line['id']} qty {had} -> {line['qty']}"
                        f"  (cart now {after['count']} line(s), {nt(after['total'])})")

        cart = read_cart(c)
        if not args.ref:
            raise Usage(f"cart {args.action} needs a line # / product id")
        ln = find_line(cart, args.ref)
        if args.action == "qty":
            if args.n is None or args.n < 1:
                raise Usage("cart qty <line> N needs N >= 1 (use `cart rm` to remove)")
            if ln["max_qty"] and args.n > ln["max_qty"]:
                raise Usage(f"max {ln['max_qty']} for this item")
            data = {"T": "UPD", "TI": ln["id"], "YTQ": args.n, "RS": ln["store"], "TB": cart_tb(ln["id"]),
                    "KEY": ln["key"], "LB": "Y"}
            what = f"set qty of line {ln['line']} {ln['title']} from {ln['qty']} to {args.n}"
        else:
            data = {"T": "DEL", "TI": ln["id"], "RS": ln["store"], "TTI": "A", "KEY": ln["key"], "LB": "Y"}
            what = f"remove line {ln['line']}: {ln['qty']}x {ln['title']} ({ln['id']})"
        if not args.yes:
            return emit(ok({"dry_run": True, "line": ln, "op": data["T"]}), args.json,
                        f"would {what}\nre-run with --yes")
        c.post(CARTAPI + "/modifyItem?_=%d" % (time.time() * 1000),
               {"data": json.dumps(data, separators=(",", ":"), ensure_ascii=False)})
        time.sleep(0.5)
        after = read_cart(c)
        now = next((x for x in after["lines"] if x["key"] == ln["key"]), None) or \
            next((x for x in after["lines"] if x["id"] == ln["id"]), None)
        if args.action == "rm":
            if now:
                raise ApiError("PChome answered the remove but the line is still in the cart", {"line": now})
            return emit(ok({"removed": ln, "verified": True, "cart_count": after["count"],
                            "cart_total": after["total"]}), args.json,
                        f"removed {ln['id']} {ln['title']}; verified gone "
                        f"(cart now {after['count']} line(s), {nt(after['total'])})")
        if not now or now["qty"] != args.n:
            raise ApiError("PChome answered the update but the cart shows a different qty",
                           {"line": now, "wanted": args.n})
        return emit(ok({"updated": now, "qty_before": ln["qty"], "verified": True,
                        "cart_total": after["total"]}), args.json,
                    f"line {now['line']} {now['title']}: qty {ln['qty']} -> {now['qty']} (verified); "
                    f"cart total {nt(after['total'])}")


