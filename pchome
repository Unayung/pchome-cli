    return f"{SITE}/prod/{pid}"


def shipping(p):
    tags = []
    if p.get("isArrival24h"):
        tags.append("24h到貨")
    st = p.get("ShipType")
    if st == "Trans":
        tags.append("廠商出貨")
    elif st == "Consign":
        tags.append("PChome倉出貨")
    elif st:
        tags.append(st)
    if p.get("PreOrdDate"):
        tags.append(f"預購 {p['PreOrdDate']}")
    if p.get("ShipDay"):
        tags.append(f"{p['ShipDay']}天出貨")
    return " ".join(tags)


def price_of(pr):
    """Price object {M: list price (0 = none), P: selling, Prime, Low} -> (price, orig)."""
    pr = pr or {}
    p = pr.get("P")
    m = pr.get("M") or None
    return p, (m if m and p is not None and m > p else None)


def discount(price, orig):
    if price and orig and orig > price:
        return f"{round(price * 100 / orig) / 10:g}折"
    return ""


def cmd_search(args):
    if args.min is not None or args.max is not None:
        rng = f"{args.min or 0}-{args.max or 9999999}"
    else:
        rng = None
    out, page = [], args.page
    with Client(args) as c:
        while len(out) < args.limit:
            q = {"q": args.query, "page": page, "sort": SORTS[args.sort]}
            if rng:
                q["price"] = rng
            d = c.get(SEARCH + "?" + urllib.parse.urlencode(q)) or {}
            prods = d.get("Prods") or []
            for p in prods:
                pr, orig = p.get("Price"), p.get("OriginPrice")
                orig = orig if orig and pr and orig > pr else None
                out.append({"id": p.get("Id"), "title": p.get("Name"), "price": pr, "orig_price": orig,
                            "discount": discount(pr, orig), "rating": p.get("ratingValue"),
                            "reviews": p.get("reviewCount"), "pchome_24h": bool(p.get("isPChome")),
                            "describe": p.get("Describe"), "url": prod_url(p.get("Id")),
                            "image": IMG + p["PicS"] if p.get("PicS") else None})
            total, pages = d.get("TotalRows"), d.get("TotalPage") or 0
            if not prods or page >= pages or len(out) >= args.limit:
                break
            page += 1
            time.sleep(0.5)
    out = out[: args.limit]
    meta = {"query": args.query, "total": total, "pages": pages, "sort": args.sort, "results": out}

    def human():
        rows = [[i + 1, r["id"], clip(r["title"], 46), nt(r["price"]), nt(r["orig_price"]), r["discount"],
                 f"{r['rating']}★({r['reviews']})" if r["reviews"] else ""] for i, r in enumerate(out)]
        return f"{total} results for {args.query!r} (sort {args.sort})\n" + table(
            rows, ["#", "id", "title", "price", "orig", "off", "rating"])
    return emit(ok(meta), args.json, human)


def fetch_product(c, pid):
    d = c.get(f"{PROD}/prod/{pid}&fields={PROD_FIELDS}") or {}
    if not d:
        raise ApiError(f"no such product {pid}")
    return d.get(pid + "-000") or next(iter(d.values()))


def fetch_specs(c, pid, p):
    """[{id, spec, qty, price, orig, buyable}] incl. -000 when the item has no specs."""
    btn = c.get(f"{PROD}/prod/button&id={pid}&fields=Id,Price,Qty,ButtonType,SaleStatus") or []
    bmap = {b["Id"]: b for b in btn}
    specs = []
    if p.get("isSpec"):
        for s in (c.get(f"{PROD}/prod/spec&id={pid}") or {}).get(pid) or []:
            b = bmap.get(s["Id"], {})
            price, orig = price_of(b.get("Price"))
            specs.append({"id": s["Id"], "spec": s.get("Spec"), "qty": b.get("Qty", s.get("Qty")),
                          "price": price, "orig_price": orig, "button": b.get("ButtonType"),
                          "buyable": b.get("ButtonType") == "ForSale" and (b.get("Qty", s.get("Qty")) or 0) > 0})
    return specs, bmap.get(pid + "-000", {})


def product_info(c, pid):
    p = fetch_product(c, pid)
    specs, main = fetch_specs(c, pid, p)
    price, orig = price_of(p.get("Price"))
    try:
        desc = (c.get(f"{PROD}/prod/{pid}/desc&fields=Id,Slogan") or {}).get(pid) or {}
    except ApiError:
        desc = {}
    slogan = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", desc.get("Slogan") or "")).strip()
    pr = p.get("Price") or {}
    btn = main.get("ButtonType") or p.get("ButtonType")
    qty = main.get("Qty", p.get("Qty"))
    in_stock = (any(s["buyable"] for s in specs) if specs
                else btn == "ForSale" and (qty or 0) > 0)
    return {"id": pid, "title": p.get("Name"), "price": price, "orig_price": orig,
            "discount": discount(price, orig), "prime_price": pr.get("Prime") or None,
            "promo": " ".join(x for x in (pr.get("DiscountText"), slogan) if x) or None,
            "in_stock": in_stock, "max_qty": qty, "button": btn, "store": p.get("Store"),
            "shipping": shipping(p), "pre_order": p.get("PreOrdDate") or None,
            "has_specs": bool(p.get("isSpec")), "specs": specs, "url": prod_url(pid),
            "image": IMG + (p.get("Pic") or {}).get("B") if (p.get("Pic") or {}).get("B") else None}


