# ------------------------------------------------------------------- login
def member_info(cookie, debug=False):
    """Verify a cookie over plain HTTP. Returns member dict or raises Auth."""
    h = Http(cookie, debug)
    code, text = h.request(MEMBER + "/islogin")
    if strip_jsonp(text).strip() != "1":
        raise Auth("PChome says this session is not signed in (member/islogin = "
                   f"{strip_jsonp(text).strip()[:20]!r}) - run `pchome login`")
    m = parse_json(MEMBER, *h.request(MEMBER)) or {}
    if m.get("Code") == 403:
        raise Auth("PChome rejected the session (member: 403) - run `pchome login`")
    email = parse_json(MEMBER, *h.request(MEMBER + "/id"))
    return {"email": email, "login_email": m.get("LoginEmail"), "mobile": m.get("LoginMobile"),
            "pcoin": m.get("PCoin"), "cash_point": m.get("CashPoint")}


def _is_logged_in(cookie):
    try:
        _, t = Http(cookie).request(MEMBER + "/islogin")
        return strip_jsonp(t).strip() == "1"
    except Net:
        return False


def from_browser(args):
    global CDP
    if args.cdp:
        CDP = args.cdp
    cks = browser_cookies()
    cookie = cookies_to_header(cks)
    if "ECWEBSESS=" in cookie and _is_logged_in(cookie):
        return cookie
    if args.wait <= 0:
        raise Auth(f"the browser on {CDP} is not signed in to PChome")
    print(f"not signed in to PChome in the browser on {CDP}; opened the login page in a "
          f"background tab - sign in there yourself (waiting up to {args.wait}s)...", file=sys.stderr)
    br = Browser(LOGIN_URL)
    try:
        t0 = time.time()
        while time.time() - t0 < args.wait:
            time.sleep(3)
            cookie = cookies_to_header(browser_cookies())
            if "ECWEBSESS=" in cookie and _is_logged_in(cookie):
                return cookie
        raise Auth(f"no PChome sign-in within {args.wait}s (tab closed; run `pchome login` again)")
    finally:
        br.close()


def _clipboard():
    for cmd in (["wl-paste", "-n"], ["pbpaste"], ["xclip", "-o", "-selection", "clipboard"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    raise Auth("clipboard is empty or no clipboard tool (wl-paste / pbpaste / xclip)")


def _read_cookie_tty():
    """Raw tty read: the Linux line editor caps a line at 4095 bytes."""
    import termios
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    print("paste the Cookie header, then press Enter (input hidden):", file=sys.stderr)
    buf = bytearray()
    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        while True:
            ch = os.read(fd, 65536)
            if not ch:
                break
            if b"\x03" in ch:
                raise KeyboardInterrupt
            buf += ch
            if b"\r" in ch or b"\n" in ch:
                break
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)
        print(file=sys.stderr)
    return buf.decode("utf-8", "replace").splitlines()[0] if buf else ""


def cmd_login(args):
    if args.from_clipboard:
        cookie, src = _clipboard(), "clipboard"
    elif args.cookie_stdin:
        cookie = (_read_cookie_tty() if sys.stdin.isatty() else sys.stdin.read()).strip()
        src = "stdin"
    else:
        cookie, src = from_browser(args), f"browser {args.cdp or CDP}"
    cookie = clean_cookie(cookie)
    try:
        u = member_info(cookie, args.debug)
    except Auth as e:
        raise Auth(f"that session is not signed in to PChome ({e})")
    st = load_state()
    st.pop("source", None)
    st.update(cookie=cookie, cookie_in_keyring=bool(args.keyring), user=u,
              logged_in_at=int(time.time()), login_source=src)
    if args.keyring:
        _keyring("set", cookie)
    save_state(st)
    out = {"user": u, "stored": "keyring" if args.keyring else STATE_FILE, "source": src}
    return emit(ok(out), args.json,
                lambda: f"signed in as {u['email'] or u['login_email']} ({u['mobile']}); "
                        f"session saved to {out['stored']}")


def cmd_whoami(args):
